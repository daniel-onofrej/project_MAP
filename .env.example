# ============================================================
# MAP — Environment Variables
# ============================================================
# Copy this file to .env and fill in your AI API keys.
# Everything else has a working default for local development.
# For production, change ALL values marked ⚠️
# ============================================================

# ── AI API Keys ───────────────────────────────────────────────
# At least one provider key is required for graph generation.
# These can also be passed into OpenShell runtimes through secretEnv mappings.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional OpenShell runtime secret pass-through sources.
# MAP stores only the source env var name, while deployment-worker injects
# the value into /sandbox/map/env.sh when the runtime starts.
LITELLM_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_AI_API_KEY=

# ── Admin account ─────────────────────────────────────────────
# No default admin is created. After first boot, create the first
# admin through POST /api/users while the users table is empty.

# ── ⚠️  Change these in production ───────────────────────────

# Database password — REQUIRED. Generate with: openssl rand -hex 24
DB_PASSWORD=

# Session secret — REQUIRED. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Key encryption secret — REQUIRED in production (encrypts group API keys in DB).
# Must be a distinct value from SESSION_SECRET so a session-secret leak does not
# also expose stored API keys. Generate with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=

# MCP server auth token — REQUIRED. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ── OpenShell sandbox deployments ───────────────────────────
# Set to false to hide/create no runtime operations from MAP APIs and UI.
OPENSHELL_RUNTIME_ENABLED=true
# Internal Docker network URLs used by MAP services.
OPENSHELL_GATEWAY_URL=http://openshell-gateway:8080
DEPLOYMENT_WORKER_URL=http://deployment-worker:3200
MCP_INTERNAL_URL=http://mcp-server:3100/mcp
DEPLOYMENT_WORKSPACE=/var/lib/map-deployments

# Local developer convenience only. When true, newly generated MCP tokens are
# copied into ignored local files such as mcp-server/.env.
AUTO_SYNC_MCP_TOKEN_TO_LOCAL_DEV=false

# MCP server — set to false to disable the MCP server entirely
# When disabled the container exits cleanly; the port stays closed
# MCP_ENABLED=true

# App URL (used for CORS and redirects)
# APP_URL=http://localhost

# Optional release/deploy version stamped into health endpoints and Docker images.
# CI passes this automatically from package.json / release tags.
APP_VERSION=0.1.0
